  m_Name: CyberFishTaskAsset
  m_EditorClassIdentifier: Assembly-CSharp::HitOrMiss.Cybersickness.CyberBugTaskAsset
  m_TaskName: Cyber Bug Prediction Task
  m_BlockCount: 1
  m_MissTrialsPerBlock: 10
  m_ContactSplashTrialsPerBlock: 10
  m_StartDistance: 5
  m_ContactDistance: 0.45
  m_PassBehindDistance: 1.2
