MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1643808108}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76a780b80c19d114fadc92d833e2b646, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HitOrMiss.Pps.SessionFlowPanels
  m_WelcomePanel: {fileID: 4424058234026343715}
  m_InstructionsPanel: {fileID: 965426598}
  m_PositioningPanel: {fileID: 0}
  m_PracticeIntroVTOnlyPanel: {fileID: 395796435}
  m_PracticeIntroVOnlyPanel: {fileID: 1468198488}
  m_PracticeIntroVTVisualPanel: {fileID: 635835273}
  m_PracticeFeedbackPanel: {fileID: 277381992}
  m_NoFeedbackPanel: {fileID: 357540654}
  m_ReadyToStartPanel: {fileID: 0}
  m_BlockCounterPanel: {fileID: 1927333692}
  m_BreakPanel: {fileID: 2041645118}
  m_PausePanel: {fileID: 93650241}
  m_EndPanel: {fileID: 940394639}
  m_BlockCounterText: {fileID: 623462703}
  m_BreakText: {fileID: 1910229895}
  m_BreakCountdownText: {fileID: 0}
  m_PracticeFeedbackText: {fileID: 955692051}
  m_EndText: {fileID: 2143914962}
  m_StandingCross: {fileID: 2068488786}
  m_PracticeFeedbackSeconds: 1
  m_ExtendBreakButton: {fileID: 412532741}
  m_ExtendBreakSeconds: 30
  m_CurrentLanguage: 0
  m_LocalizedTexts:
  - textTarget: {fileID: 6610604724836508754}
    english: Welcome to Task 1
    french: "Bienvenue \xE0 la t\xE2che 1"
  - textTarget: {fileID: 0}
    english: Start
    french: Commencer
  - textTarget: {fileID: 671514806}
    english: Select Other Language
    french: Selectionner Autre Langue
  - textTarget: {fileID: 1200385535}
    english: Stop
    french: "Arr\xEAter la t\xE2che\r\n"
  - textTarget: {fileID: 53756947}
    english: Continue
    french: Continuer
  - textTarget: {fileID: 376609664}
    english: Back
    french: Retour
  - textTarget: {fileID: 869205363}
    english: In this task, you will feel gentle vibrations on your chest.\nAt times,
      you will also see lights moving toward you.\nYour task is to respond to the
      vibration:\n when you feel it, press the controller as quickly as you can.
    french: "Dans cette t\xE2che, vous ressentirez de l\xE9g\xE8res vibrations sur
      votre poitrine.\\nPar moments, vous verrez \xE9galement des lumi\xE8res se
      d\xE9placer vers vous.\\nVotre t\xE2che est de r\xE9pondre \xE0 la vibration
      : \\n lorsque vous la ressentez, appuyez sur la manette aussi rapidement que
      possible."
  - textTarget: {fileID: 1345587028}
    english: "This task includes three types of trials: vibration only, light only,
      and vibration with light.\\nLet\u2019s practice what each one looks like.\r\n"
    french: "Cette t\xE2che comprend trois types d\u2019essais : vibration seule,
      lumi\xE8re seule, et vibration avec lumi\xE8re.\\nEntra\xEEnons-nous \xE0 voir
      \xE0 quoi ressemble chacun d\u2019eux.\r\n"
  - textTarget: {fileID: 2028544632}
    english: Now, in this type of trial, you will see a light, but you will not feel
      any vibration.
    french: "Maintenant, dans ce type d\u2019essai, vous verrez une lumi\xE8re, mais
      vous ne sentirez aucune vibration. "
  - textTarget: {fileID: 929655511}
    english: 'When you feel a vibration, press the controller as soon as you can.

'
    french: "Tr\xE8s bien! \\n\\nMaintenant, ajoutons les lumi\xE8res en mouvement.\\nLes
      lumi\xE8res vont avancer vers vous.\\nLorsque vous sentez une vibration, appuyez
      sur la manette d\xE8s que possible."
  - textTarget: {fileID: 518538310}
    english: 'The main task will now begin.\nThe rule is the same: when you feel
      a vibration,\n press the controller as soon as you can.

'
    french: "La t\xE2che principale va maintenant commencer.\\nLa r\xE8gle reste
      la m\xEAme :\\n lorsque vous sentez une vibration, appuyez sur la manette d\xE8s
      que possible."
  - textTarget: {fileID: 623462703}
    english: 'Block {currentBlock} / {totalBlocks} Insole Check: Raise and lower
      your left foot, then your right foot.'
    french: "Bloc {currentBlock} / {totalBlocks}\n\nV\xE9rification des semelles
      :Levez puis posez le pied gauche, puis le pied droit."
  - textTarget: {fileID: 1532550668}
    english: Begin Block
    french: Commencer le Bloc
  - textTarget: {fileID: 1910229895}
    english: It is now time for a {breakTime} break. \n\nYou can sit comfortably
      in the chair provided next to you during this time.
    french: "C'est le moment de faire une pause de {breakTime}.\\n\\nVous pouvez
      vous installer confortablement sur la chaise mise \xE0 votre disposition pendant
      ce temps."
  - textTarget: {fileID: 124875369}
    english: Extend Break!
    french: Prolonguez le break!
  - textTarget: {fileID: 323607683}
    english: 'The task has been paused.\n\nPress Resume to start a new trial, or
      restart the whole block. '
    french: "La t\xE2che a \xE9t\xE9 mise en pause.\\n\\nAppuyez sur Reprendre pour
      commencer un nouvel essai, ou recommencez tout le bloc."
  - textTarget: {fileID: 2123794633}
    english: Resume next trial
    french: Commencer un nouvel essai
  - textTarget: {fileID: 877618364}
    english: 'Restart Current Blcok '
    french: Recommencez le bloc.
  - textTarget: {fileID: 2143914962}
    english: 'This is the end of the task. \n\n Please wait for the experimenter''s
      instructions. '
    french: "C\u2019est la fin de la t\xE2che.\\n\\nVeuillez attendre les instructions
      de l\u2019exp\xE9rimentateur."
  - textTarget: {fileID: 0}
    english: Return to clinician menu
    french: Aller sur le menu principale
  - textTarget: {fileID: 1592504050}
    english: End Session
    french: Terminez la seance
  - textTarget: {fileID: 955692051}
    english: 'You did not respond.

      Please press the button when you feel the
      vibration.'
    french: "Vous n'avez pas r\xE9pondu.\nAppuyez sur le bouton quand vous sentez
      la vibration."
  - textTarget: {fileID: 955692051}
    english: Continue
    french: Continuer
  - textTarget: {fileID: 0}
    english: Continue
    french: Continuer
  - textTarget: {fileID: 1738140942}
    english: Stop
    french: "Arr\xEAter la t\xE2che\r\n"
  - textTarget: {fileID: 104309410}
    english: Start Practice
    french: "Commencer l\u2019entra\xEEnement"
  - textTarget: {fileID: 613252946}
    english: Back
    french: Retour
  - textTarget: {fileID: 169272652}
