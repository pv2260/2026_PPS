  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76a780b80c19d114fadc92d833e2b646, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HitOrMiss.Pps.SessionFlowPanels
  m_WelcomePanel: {fileID: 4424058234026343715}
  m_TriggerCheckPanel: {fileID: 696450625}
  m_InstructionsPanel: {fileID: 965426598}
  m_PositioningPanel: {fileID: 2070559567}
  m_PracticeIntroVTOnlyPanel: {fileID: 395796435}
  m_PracticeIntroVTVisualPanel: {fileID: 635835273}
  m_PracticeFeedbackPanel: {fileID: 277381992}
  m_NoFeedbackPanel: {fileID: 357540654}
  m_ReadyToStartPanel: {fileID: 2093654693}
  m_BlockCounterPanel: {fileID: 1927333692}
  m_BreakPanel: {fileID: 2041645118}
  m_PausePanel: {fileID: 93650241}
  m_EndPanel: {fileID: 940394639}
  m_TriggerCheckText: {fileID: 912753167}
  m_BlockCounterText: {fileID: 623462703}
  m_BreakText: {fileID: 1910229895}
  m_BreakCountdownText: {fileID: 0}
  m_PracticeFeedbackText: {fileID: 955692051}
  m_EndText: {fileID: 2143914962}
  m_StandingCross: {fileID: 2068488786}
  m_PracticeFeedbackSeconds: 1
  m_CurrentLanguage: 0
  m_LocalizedTexts:
  - textTarget: {fileID: 6610604724836508754}
    english: Welcome to Task 1
    french: "Bienvenue \xE0 la t\xE2che 1"
  - textTarget: {fileID: 1779370687}
    english: Start
    french: Commencer
  - textTarget: {fileID: 671514806}
    english: Language Settings
    french: Selectionner Langue
  - textTarget: {fileID: 1200385535}
    english: Stop
    french: Arreter la Tache
  - textTarget: {fileID: 912753167}
    english: Please confirm that EEG/EMG triggers are being received correctly.
    french: "Veuillez confirmer que les signaux EEG/EMG sont bien re\xE7us."
  - textTarget: {fileID: 53756947}
    english: Start Practice
    french: Demarrer la practice
  - textTarget: {fileID: 376609664}
    english: Back
    french: Avant
  - textTarget: {fileID: 869205363}
    english: In this task, lights may move toward you.\nYou may also feel a chest
      vibration.\nRespond ONLY to the vibration.\nDo NOT respond to lights alone.\nRespond
      quickly and accurately.\nPress Start Practice when ready.
    french: "Pendant cette t\xE2che, des lumi\xE8res peuvent appara\xEEtre et se
      d\xE9placer vers vous.\\nParfois, vous ressentirez \xE9galement une vibration
      sur votre poitrine.\\nR\xE9pondez UNIQUEMENT lorsque vous ressentez la vibration.\\nNe
      r\xE9pondez pas aux lumi\xE8res seules.\\nVeuillez r\xE9pondre aussi rapidement
      et pr\xE9cis\xE9ment que possible.\\nAppuyez sur D\xE9marrer l\u2019entra\xEEnement
      lorsque vous \xEAtes pr\xEAt."
  - textTarget: {fileID: 1270008075}
    english: Please stand on the X marker and face forward facing the cross.\nRemain
      as still as possible.\nPress Start Practice when ready.
    french: "Pour commencer, veuillez vous tenir debout sur le rep\xE8re X au sol.\\nRegardez
      droit devant vous, en direction de la croix.\\nRestez aussi immobile que possible
      pendant la t\xE2che.\\nAppuyez sur Demarrer l'entra\xEEnement  lorsque vous
      \xEAtes pr\xEAt."
  - textTarget: {fileID: 1345587028}
    english: "Before we start the main task, let's practice one important part. \\nYou
      might feel a vibration on your chest from time to time.\\nWhenever you feel
      that vibration, press your controller as fast as you can.\\nLet\u2019s give
      it a try!"
    french: "Avant de commencer la t\xE2che principale, entra\xEEnons-nous sur un
      \xE9l\xE9ment important.\\nVous pourriez ressentir une vibration dans la poitrine
      de temps \xE0 autre.\\nD\xE8s que vous ressentez cette vibration, appuyez sur
      votre manette le plus rapidement possible.\\nC'est parti, essayons !"
  - textTarget: {fileID: 929655511}
    english: Now, let's add the next part. \nYou will also see lights moving toward
      you.\nRemember, respond ONLY when you feel a vibration.\nPress the controller
      as quickly as possible.
    french: "\xC0 pr\xE9sent, passons \xE0 l'\xE9tape suivante.\\nVous verrez \xE9galement
      des lumi\xE8res se d\xE9placer vers vous.\\nRappelez-vous, r\xE9pondez UNIQUEMENT
      lorsque vous ressentez une vibration.\\nAppuyez sur la manette le plus rapidement
      possible."
  - textTarget: {fileID: 518538310}
    english: Practice is now complete. \nThe real task will now begin. \nYou will
      no longer receive feedback.\nAre you ready?
    french: "L'entra\xEEnement est maintenant termin\xE9.\\nLa t\xE2che r\xE9elle
      va maintenant commencer.\\nVous ne recevrez plus de commentaires.\\n\xCAtes-vous
      pr\xEAt ?"
  - textTarget: {fileID: 580178337}
    english: The task consists of {blocksCount} blocks. There will be breaks in between,
      and we will be right here to assist you if you need anything.\n\nAre you ready
      to start?
    french: "La t\xE2che est divis\xE9e en {blocksCount} blocs. Des temps de pause
      sont pr\xE9vus, et nous serons \xE0 vos c\xF4t\xE9s pour vous aider si vous
      en avez besoin.\\n\\n\xCAtes-vous pr\xEAt \xE0 commencer ?"
  - textTarget: {fileID: 623462703}
    english: Block {currentBlock} / {totalBlocks}
    french: Bloc {currentBlock} / {totalBlocks}
  - textTarget: {fileID: 1532550668}
    english: Begin Block
    french: Commencer le Bloc
  - textTarget: {fileID: 1910229895}
    english: It is now time for a {breakTime} break. You can sit comfortably in the
      chair provided next to you during this time.
    french: "C'est le moment de faire une pause de {breakTime}. Vous pouvez vous
      installer confortablement sur la chaise mise \xE0 votre disposition pendant
      ce temps."
  - textTarget: {fileID: 124875369}
    english: Extend Break!
    french: Prolonguez le break!
  - textTarget: {fileID: 323607683}
    english: 'The task has been paused.\nPress Resume to start a new trial, or restart
      the whole block. '
    french: "\"La t\xE2che a \xE9t\xE9 mise en pause.\\nAppuyez sur Reprendre pour
      commencer un nouvel essai, ou recommencez tout le bloc."
  - textTarget: {fileID: 2123794633}
    english: Resume next trial
    french: Commencer un nouvel essai
  - textTarget: {fileID: 877618364}
    english: 'Restart Current Blcok '
    french: Recommencez le bloc.
  - textTarget: {fileID: 2143914962}
    english: 'This is the end of the task. \n Please wait for the experimenter''s
      instructions. '
    french: "C\u2019est la fin de la t\xE2che.\\nVeuillez attendre les instructions
      de l\u2019exp\xE9rimentateur."
  - textTarget: {fileID: 1907096238}
    english: Return to clinician menu
    french: Aller sur le menu principale
  - textTarget: {fileID: 1592504050}
    english: End Session
    french: Terminez la seance
