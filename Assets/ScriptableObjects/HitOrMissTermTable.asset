%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90a31742b4988d64896200d05b98a005, type: 3}
  m_Name: HitOrMissTermTable
  m_EditorClassIdentifier: 
  m_Entries:
  - key: popup1_intro
    english: 'In this task, a ball will move towards you. \nYour task is to decide
      whether the ball will hit or miss you. \nRespond as quickly and accurately
      as possible.   '
    french: "Dans cette t\xE2che, une balle va se d\xE9placer vers vous. \\nVotre
      r\xF4le est de d\xE9cider si la balle va vous toucher ou vous \xE9viter (manquer).  "
  - key: popup2_triggercheck
    english: 'Please confirm that EEG/EMG triggers are being received correctly. '
    french: "Veuillez confirmer que les triggers EEG/EMG sont correctement re\xE7us."
  - key: popup3_positioning
    english: Please stand in front of the cross. \nFace forward and hold both controllers
      comfortably.
    french: Veuillez vous placer devant la croix. \nRegardez droit devant vous et
      tenez les deux manettes confortablement.
  - key: popup3a_positioningak
    english: 'Press the trigger when you have positioned yourself. '
    french: "Appuyez sur la g\xE2chette lorsque vous \xEAtes bien positionn\xE9(e)."
  - key: popup4_controllerpracticeintro
    english: "In this task, you will use the controllers to answer. \\nLEFT means
      YES, the ball will hit me. \\nRIGHT means NO, the ball will miss me. \\nLet\u2019s
      practice the buttons first."
    french: "Dans cette t\xE2che, vous utiliserez les manettes pour r\xE9pondre.
      \\nGAUCHE signifie OUI, la balle va me toucher. \\nDROITE signifie NON, la
      balle va me manquer. \\nEntra\xEEnons-nous d\u2019abord avec les boutons."
  - key: popup5_leftcontrollerpractice
    english: 'Press the LEFT controller for YES. \nYES means: the ball will hit me.'
    french: 'Appuyez sur la manette GAUCHE pour OUI. \nOUI signifie : la balle va
      me toucher.'
  - key: popup6_rightcontrollerpractice
    english: 'Press the RIGHT controller for NO. \nNO means: the ball will miss me. '
    french: 'Appuyez sur la manette DROITE pour NON. \nNON signifie : la balle va
      me manquer.'
  - key: popup7_balldemointro
    english: 'A ball will move toward you. \nDecide whether it will hit you or miss
      you. \nIf it hits, you will see a splash; if it misses, it will pass by. \nFirst,
      watch TWO EXAMPLES WITHOUT PRESSING ANYTHING. '
    french: "Une balle se d\xE9placera vers vous. \\nIndiquez si elle va vous toucher
      ou vous manquer. \\nSi elle vous touche, vous verrez une \xE9claboussure ;
      si elle vous manque, elle passera \xE0 c\xF4t\xE9. \\nVous allez d\u2019abord
      regarder DEUX EXEMPLES SANS APPUYER sur quoi que ce soit."
  - key: popup8_easypractice
    english: "Now it\u2019s your turn. \\nYou will start with easy examples. \\nAfter
      each ball, answer: will it hit you? \\nLEFT = yes \\nRIGHT = no."
    french: "\xC0 vous maintenant. \\nVous allez commencer par des exemples faciles.
      \\nApr\xE8s chaque balle, r\xE9pondez : va-t-elle vous toucher ? \\nGAUCHE
      = oui \\nDROITE = non."
  - key: popup9_difficult
    english: Good! Now the task will become slightly harder. \nSome balls will clearly
      hit or miss you. \nOthers will pass very close to your body. \nLets give it
      a try!
    french: "Bien ! La t\xE2che va maintenant devenir un peu plus difficile.\\nCertaines
      balles vont clairement vous toucher ou vous manquer.\\nD\u2019autres passeront
      tr\xE8s pr\xE8s de votre corps.\\nEssayons !"
  - key: popup10_practiceretry
    english: "Let\u2019s try the practice again. \\nTry to respond before the ball
      reaches you."
    french: "Recommen\xE7ons l\u2019entra\xEEnement. \\nEssayez de r\xE9pondre avant
      que la balle ne vous atteigne."
  - key: popup11_tooslow
    english: 'Too Slow! '
    french: Trop lent !
  - key: popup12_nofeedback
    english: Practice is complete.\nThe real task will now begin.\nYou will no longer
      receive feedback.\nNo colors or correctness messages will be shown.
    french: "La pratique est termin\xE9e.\\nLa vraie t\xE2che va maintenant commencer.\\nVous
      ne recevrez plus de retour.\\nAucune couleur ni aucun message de correction
      ne sera affich\xE9."
  - key: popup13_ready
    english: Are you ready to begin?.\nStart when you are ready.
    french: "\xCAtes-vous pr\xEAt \xE0 commencer ? .\\nAppuyez sur Start quand vous
      \xEAtes pr\xEAt."
  - key: popup14_block_intro
    english: Let's start with Block {block}. .\nPress Begin when you are ready.
    french: "Commen\xE7ons avec le Bloc {block}. .\\nAppuyez sur Commencer quand
      vous \xEAtes pr\xEAt"
  - key: popup15_break
    english: All done with Block {block}. .\nTake a little break.
    french: "Bloc {block} termin\xE9. .\\nPrenez une petite pause."
  - key: popup16_next_block
    english: Are you ready to start with Block {block}?.\nLet's go!
    french: "Pr\xEAt(e) \xE0 commencer le Bloc {block} ? .\\nAllons-y !"
  - key: popup17_outro
    english: You are all done. .\nThank you for your participation.
    french: "C'est termin\xE9. .\\nMerci pour votre participation."
  - key: say_hit
    english: HIT
    french: TOUCHE
  - key: say_miss
    english: MISS
    french: "RAT\xC9"
