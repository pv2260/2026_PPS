%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90a31742b4988d64896200d05b98a005, type: 3}
  m_Name: HitOrMissTermTable
  m_EditorClassIdentifier: 
  m_Entries:
  - key: popup1_intro
    english: 'In this task, a ball will move towards you. \nYour task is to decide
      whether the ball will hit or miss you. '
    french: "Dans cette t\xE2che, une balle va se d\xE9placer vers vous. \\nVotre
      r\xF4le est de d\xE9cider si la balle va vous toucher ou vous manquer.  "
  - key: popup3_positioning
    english: To begin, please stand in front of the cross. \nFace forward and hold
      both controllers comfortably.
    french: Pour commencer, placez-vous devant la croix.\nRegardez droit devant vous
      et tenez les deux manettes confortablement.
  - key: popup3a_positioningak
    english: 'Press the trigger when you have positioned yourself. '
    french: "Appuyez sur la g\xE2chette lorsque vous \xEAtes bien positionn\xE9(e)."
  - key: popup4_controllerpracticeintro
    english: You will use BOTH controllers to answer.\n Lets remember how to use
      them.
    french: "Vous utiliserez les DEUX contr\xF4leurs pour r\xE9pondre.\\nRappelons
      comment les utiliser."
  - key: popup7_balldemointro
    english: How will you know if the ball hit you?\nIf it hits you, you will see
      a splash.\nIf it misses, it will pass by.\nFirst, watch TWO examples without
      pressing anything.
    french: "Comment saurez-vous si la balle vous a touch\xE9 ?\\nSi elle vous touche,
      vous verrez une \xE9claboussure.\\nSi elle vous manque, elle passera \xE0 c\xF4t\xE9.\\nRegardez
      d\u2019abord DEUX exemples sans appuyer sur rien."
  - key: popup8_easypractice
    english: "Now it\u2019s your turn. \\nYou will start with easy examples. "
    french: "\xC0 vous maintenant. \\nVous allez commencer par des exemples faciles. "
  - key: popup9_difficult
    english: "Great! Now let\u2019s put it into practice. "
    french: "Tr\xE8s bien ! Maintenant, mettons cela en pratique. "
  - key: popup10_practiceretry
    english: "Let\u2019s try the practice again. \\nTry to respond before the ball
      reaches you."
    french: "Recommen\xE7ons l\u2019entra\xEEnement. \\nEssayez de r\xE9pondre avant
      que la balle ne vous atteigne."
  - key: popup11_tooslow
    english: 'Too Slow! '
    french: Trop lent !
  - key: popup12_nofeedback
    english: Practice is now complete.\nThe task will  begin.
    french: "La pratique est termin\xE9e.\\nLa vraie t\xE2che va maintenant commencer."
  - key: popup13_ready
    english: Are you ready to begin?.\nPress Start when you are ready.
    french: "\xCAtes-vous pr\xEAt \xE0 commencer ? .\\nAppuyez sur Start quand vous
      \xEAtes pr\xEAt."
  - key: popup14_block_intro
    english: Let's start with Block {block}. \nPress Begin Block when you are ready.
    french: "Commen\xE7ons avec le Bloc {block}. \\nAppuyez sur Commencer quand vous
      \xEAtes pr\xEAt"
  - key: popup15_break
    english: All done with Block {block}. .\nTake a little break.
    french: "Bloc {block} termin\xE9. .\\nPrenez une petite pause."
  - key: popup16_next_block
    english: Are you ready to start with Block {block}?.\nLet's go!
    french: "Pr\xEAt(e) \xE0 commencer le Bloc {block} ? .\\nAllons-y !"
  - key: popup17_outro
    english: You are all done. .\nThank you for your participation.
    french: "C'est termin\xE9. .\\nMerci pour votre participation."
  - key: say_hit
    english: HIT
    french: TOUCHE
  - key: say_miss
    english: MISS
    french: "RAT\xC9"
  - key: trigger_demo_key
    english: You will use the TRIGGERS in the controllers to enter your responses.\n
      Give it a try!
    french: "Vous utiliserez les G\xC2CHETTES des manettes pour entrer vos r\xE9ponses.\\n\\nEssayez
      maintenant ! "
  - key: trigger_mapping
    english: 'Each time a ball moves toward you, decide whether it will hit you or
      miss you.\n\nLEFT= YES, it will hit me.\nRIGHT= NO, it will miss me. '
    french: "Chaque fois qu\u2019une balle se d\xE9place vers vous, d\xE9cidez si
      elle va vous toucher ou vous manquer.\\n\\n GAUCHE = OUI, elle va me toucher.\\
      nDROITE = NON, elle va me manquer. "
  - key: trigger_mapping
    english: 'Each time a ball moves toward you, decide whether it will hit you or
      miss you.\n\nLEFT= YES, it will hit me.\nRIGHT= NO, it will miss me. '
    french: "Chaque fois qu\u2019une balle se d\xE9place vers vous, d\xE9cidez si
      elle va vous toucher ou vous manquer.\\n\\nGAUCHE / O = OUI, elle va me toucher.\\nDROITE
      /= NON, elle va me manquer. "
  - key: intro_continue
    english: Continue
    french: Continuer
  - key: intro_continue
    english: Continue
    french: Continuer
  - key: block_intro
    english: Begin Block
    french: Commencer le Bloc
  - key: welcome_switchlanguage
    english: Switch Language
    french: Choisir Langue
  - key: welcome_start
    english: Start
    french: Commencer
  - key: controller_check
    english: Check Controllers
    french: 'Tester les manettes '
  - key: welcome_start
    english: Start
    french: Commencer
  - key: diff_practice
    english: Begin Practice
    french: "Commencer l\u2019entra\xEEnement "
