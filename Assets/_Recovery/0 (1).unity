    - target: {fileID: 8102873957092960355, guid: 849c46acce8682c44806d2b83f3d4027, type: 3}
      propertyPath: m_text
      value: "In this task, a ball will move towards you.\n\nYour task is to decide
        whether the ball will hit or miss you. \n\nPress the LEFT controller if you
        think the ball will HIT you.\n\nPress the RIGHT controller ifyou think the
        ball will MISS you.\n\nYou should respond as quickly and accurately as possible. "
      objectReference: {fileID: 0}
